{
  "name": "sexdiary",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:core && pnpm --parallel --filter @sexdiary/core --filter @sexdiary/web dev",
    "build": "pnpm build:core && pnpm --filter @sexdiary/web build",
    "build:core": "pnpm --filter @sexdiary/core build",
    "preview": "pnpm --filter @sexdiary/web preview",
    "lint": "eslint .",
    "test": "pnpm --filter @sexdiary/core test",
    "typecheck": "pnpm build:core && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2"
  }
}
